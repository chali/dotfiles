{
  "theme": "modern-dark",
  "packages": [
    "npm:@llblab/pi-codex-usage",
    "npm:pi-notify"
  ],
  "lastChangelogVersion": "0.80.10",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-terra",
